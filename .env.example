# Copy this file to .env and fill in the values. The .env file is ignored by Git.

# Authentication. The authorized service-account key is preferred.
YC_SERVICE_ACCOUNT_KEY_FILE=authorized_key.json

# Optional fallback for a short-lived user token. The key file wins if both are set.
IAM_TOKEN=

# Operation to run. Start with users and YC_DRY_RUN=true.
YC_OPERATION=users

# Cloud where personal folders will be created. The organization is derived from it.
YC_CLOUD_ID=

# User Pool find-or-create settings. Keep YC_USERPOOL_ID empty to look up by name.
YC_USERPOOL_ID=
YC_USERPOOL_NAME=scale-2026-workshop
YC_USERPOOL_SUBDOMAIN=scale-2026-workshop
YC_CREATE_USERPOOL=true

# Optional exact domain override for an existing pool. Normally leave empty.
YC_USER_DOMAIN=

# Shared namespace: users <prefix>_001, folders <prefix>-f-001,
# databases <prefix>-db-001, and dedicated-mode networks <prefix>-vpc-001.
YC_NUM_USERS=1
YC_WORKSHOP_PREFIX=ydb
YC_START_INDEX=1
YC_PASSWORD_LENGTH=11
# false keeps the generated password permanent for workshop logins.
YC_REQUIRE_PASSWORD_CHANGE=false
YC_FOLDER_ROLE=ydb.editor

# Optional future RFC3339 timestamp, for example 2027-01-31T21:00:00Z.
YC_USER_EXPIRES_AT=

# A dry run validates the configuration and checks remote name conflicts.
YC_DRY_RUN=true

# The CSV contains plaintext passwords. Keep it outside shared folders.
YC_CREATED_USERS_FILE=created_users.csv
YC_RESOURCE_MANIFEST_FILE=workshop_resources.csv
YC_OVERWRITE_OUTPUT=false

# Finite timeout applied to every HTTP request.
YC_REQUEST_TIMEOUT_SECONDS=30

# Optional settings used by other operation modes.
# YC_USER_IDS=
# YC_FOLDER_IDS=
# YC_SKIP_FOLDER_IDS=
# YC_CREATE_YDB_IN_FOLDERS=
# Serverless YDB limits. The storage value is converted to bytes for the API.
YC_SERVERLESS_STORAGE_SIZE_LIMIT_GB=5
YC_SERVERLESS_ENABLE_THROTTLING=true
YC_SERVERLESS_THROTTLING_RCU_LIMIT=10
# Keep at 0 unless you intentionally want provisioned-capacity billing.
YC_SERVERLESS_PROVISIONED_RCU_LIMIT=0
# Required in addition to YC_DRY_RUN=false for delete-ydb.
YC_CONFIRM_DELETE_YDB=false
# YC_BATCH_SIZE=16
# YC_OUTPUT_DIR=load
